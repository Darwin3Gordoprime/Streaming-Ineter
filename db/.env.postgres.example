# Configuración PostgreSQL para migración a Azure
# Copiar a .env o usar con DATABASE_URL

# Opción 1: URL completa (recomendado para Azure)
DATABASE_URL=postgresql://usuario:contraseña@servidor.postgres.database.azure.com:5432/ineter?sslmode=require

# Opción 2: Variables separadas
PGHOST=servidor.postgres.database.azure.com
PGPORT=5432
PGDATABASE=ineter
PGUSER=usuario
PGPASSWORD=contraseña
PGSSLMODE=require

# Bandera informativa: el runtime actual sigue usando JSON.
# La migración se hace con scripts/export-state-to-sql.js.
USE_POSTGRES=false
