# Si publicas la entrada RTMP tras un dominio y TLS, coloca aquí la dirección pública.
# Ejemplo orientativo: rtmps://stream.tudominio.com/live
PUBLIC_RTMP_URL=rtmp://127.0.0.1:1935/live

# Por seguridad, la web y RTMP solo aceptan conexiones desde esta PC de forma predeterminada.
# Para permitir acceso desde la red local, cambia APP_BIND_ADDRESS a 0.0.0.0.
# RTMP_BIND_ADDRESS=0.0.0.0 permite que OBS/otra fuente en otra PC de la LAN publique al servidor.
APP_BIND_ADDRESS=127.0.0.1
ADMIN_BIND_ADDRESS=127.0.0.1
RTMP_BIND_ADDRESS=127.0.0.1

# Puertos locales: plataforma principal y dashboard administrativo independiente.
PORT=3000
ADMIN_PORT=3012

# Si OBS está en otra PC, usa aquí la IP LAN de la PC que ejecuta el servidor.
OBS_INGEST_SERVER=rtmp://127.0.0.1:1935/live

# Solo para deploy/azure/docker-compose.azure.yml: sustituye ambos dominios por los tuyos.
# APP_DOMAIN=app.ejemplo.org
# STREAM_DOMAIN=stream.ejemplo.org
# PUBLIC_RTMP_URL=rtmps://stream.ejemplo.org:1936/live
# OBS_INGEST_SERVER=rtmps://stream.ejemplo.org:1936/live

# Para grabaciones en un disco administrado montado, usa su ruta, por ejemplo /srv/ineter/recordings.
# La ruta debe existir en el anfitrión antes de iniciar Docker Compose.
RECORDINGS_PATH=./recordings

# Solo activa esto cuando el backend está detrás de un proxy de confianza que sobrescribe X-Forwarded-Proto.
TRUST_PROXY=0

# Difusión de alertas por correo (Resend). Remitente de un dominio verificado.
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# Firebase Web (valores públicos de Configuración del proyecto > Tus apps > Web)
FIREBASE_API_KEY=AIzaSyBfU9WnRJ4qhK1-XFJMUmHQfhekCv1lA0s
FIREBASE_AUTH_DOMAIN=ineter-streaming.firebaseapp.com
FIREBASE_PROJECT_ID=ineter-streaming
FIREBASE_APP_ID=1:730781702967:web:b3f26527a9aeb18c7858b2
FIREBASE_MESSAGING_SENDER_ID=730781702967
FIREBASE_VAPID_KEY=

# Correo verificado de la cuenta administradora principal. Debe mantenerse definido
# para administrar accesos al monitoreo; el backend compara este valor con Firebase.
INETER_INITIAL_ADMIN_EMAIL=

# Firebase Admin (secreto privado). En local, indica la ruta absoluta del JSON.
# En Docker, monta el archivo como solo lectura y usa esa ruta dentro del contenedor.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Archivo JSON en el equipo anfitrión para Docker Compose; se monta de solo lectura.
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
